{
  "name": "packfinder-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:create": "ts-node src/db/migrate-create.ts",
    "ingest:tcgcsv": "ts-node packages/connectors/tcgcsv/ingest.ts",
    "ingest:zip": "ts-node packages/geo/zip/ingest.ts",
    "ingest:stores": "ts-node packages/geo/stores/ingest.ts",
    "ingest:all": "npm run ingest:zip && npm run ingest:stores && npm run ingest:tcgcsv",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run build && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "pg": "^8.11.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "playwright": "^1.58.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
