# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Railway: auto-injected as DATABASE_URL — no action needed
# Render:  auto-injected via fromDatabase in render.yaml
# Local:   postgresql://user:password@localhost:5432/packfinder
DATABASE_URL=postgresql://user:password@localhost:5432/packfinder

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Admin routes (/admin/scraper/*) ───────────────────────────────────────────
# Make up any strong password — set the same value in Vercel as VITE_ADMIN_SECRET
ADMIN_SECRET=change-me

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Browser scraping proxy (Oracle Cloud ARM) ─────────────────────────────────
# Enables Amazon / Walmart / Target / GameStop / Best Buy scrapers.
# Deploy services/scrapling-proxy/ to your OCI instance first (bash setup.sh),
# then paste its public IP here.
SCRAPLING_API_URL=http://YOUR_OCI_IP:8787
SCRAPLING_API_SECRET=change-me

# ── Retailer API keys (optional) ──────────────────────────────────────────────
# Best Buy: https://developer.bestbuy.com/ (free, instant)
BESTBUY_API_KEY=
# JustTCG: contact them for a key
JUSTTCG_API_KEY=

# ── TCG data sources (optional — scrapers degrade gracefully without them) ────
# Pokémon TCG API: free key at https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
ONEPIECE_TCG_API_URL=https://optcgapi.com/api
TCGDEX_API_URL=https://api.tcgdex.net/v2/en

# ── Frontend-only (set these in Vercel, not here) ─────────────────────────────
# VITE_API_URL=https://your-railway-or-render-api-url.com
# VITE_ADMIN_SECRET=same-value-as-ADMIN_SECRET-above
