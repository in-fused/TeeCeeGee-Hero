# PostgreSQL connection (required)
DATABASE_URL=postgresql://user:password@localhost:5432/packfinder

# Server
PORT=3000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# External TCG API Keys (optional — connectors degrade gracefully without them)
# Get a free key at https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
ONEPIECE_TCG_API_URL=https://optcgapi.com/api
TCGDEX_API_URL=https://api.tcgdex.net/v2/en
