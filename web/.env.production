# Production API URL — set this to your Oracle Cloud ARM public IP/domain.
# Format: http://YOUR_OCI_IP:3000  (API directly on port 3000)
#         https://your-domain.com  (if nginx sits in front)
#
# This is overridden by VITE_API_URL in your Vercel project env vars —
# set it there so you don't have to rebuild when the URL changes.
VITE_API_URL=http://YOUR_OCI_IP:3000
